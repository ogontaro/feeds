{
  "name": "feeds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "translate": "bun run src/translate/run.ts",
    "report:collect": "bun run src/digest/report-collect.ts",
    "report:render": "bun run src/digest/report-render.ts",
    "release:collect": "bun run src/digest/release-collect.ts",
    "release:render": "bun run src/digest/release-render.ts",
    "build": "bun run src/site/build.ts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "fast-xml-parser": "^4.4.1",
    "feed": "^4.2.2",
    "marked": "^12.0.2",
    "rss-parser": "^3.13.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.10"
  },
  "trustedDependencies": ["@biomejs/biome"]
